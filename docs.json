{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "포토이토 사용자 가이드",
  "colors": {
    "primary": "#8a6543",
    "light": "#f6dfb7",
    "dark": "#9d7d46"
  },
  "favicon": {
    "light": "/logo/photoito_favicon.svg",
    "dark": "/logo/photoito_favicon.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "ko",
        "groups": [
          {
            "group": "시작하기",
            "icon": "house",
            "pages": [
              "index",
              "support"
            ]
          },
          {
            "group": "설치 및 수리",
            "icon": "gear",
            "pages": [
              "install/prepare"
            ]
          },
          {
            "group": "대시보드",
            "icon": "digital-tachograph",
            "pages": [
              "dashboard/index",
              "dashboard/app",
              {
                "group": "매일 보는 화면",
                "expanded": true,
                "pages": [
                  "dashboard/overview",
                  "dashboard/analytics",
                  "dashboard/usage-history"
                ]
              },
              {
                "group": "키오스크",
                "pages": [
                  "dashboard/devices",
                  "dashboard/presets"
                ]
              },
              {
                "group": "콘텐츠",
                "expanded": true,
                "pages": [
                  "dashboard/frame-design",
                  "dashboard/frames",
                  "dashboard/frames-advanced",
                  "dashboard/themes",
                  "dashboard/categories",
                  "dashboard/filters",
                  "dashboard/library"
                ]
              },
              {
                "group": "가게 운영",
                "pages": [
                  "dashboard/coupons",
                  "dashboard/alerts",
                  "dashboard/staff",
                  "dashboard/store-info",
                  "dashboard/notices"
                ]
              },
              {
                "group": "청구 및 구독",
                "pages": [
                  "dashboard/license",
                  "dashboard/potato",
                  "dashboard/payments",
                  "dashboard/payment-methods"
                ]
              }
            ]
          },
          {
            "group": "오류 해결하기",
            "icon": "warning",
            "pages": [
              "troubleshooting/boot",
              "troubleshooting/upload"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "홈페이지",
          "icon": "plane-landing-gear",
          "href": "https://www.photoito.kr"
        },
        {
          "anchor": "대시보드",
          "icon": "dashboard",
          "href": "https://dashboard.photoito.kr"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/photoito_docs_logo_light.png",
    "dark": "/images/photoito_docs_logo_dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "문의하기",
        "href": "https://yl706.channel.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "대시보드 열기",
      "href": "https://dashboard.photoito.kr"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "포토이토 키오스크를 설치하고, 대시보드로 가게를 운영하는 방법을 안내해요.",
  "redirects": [
    {
      "source": "/file-1",
      "destination": "/dashboard/frame-design"
    },
    {
      "source": "/file-10",
      "destination": "/troubleshooting/upload"
    }
  ]
}
