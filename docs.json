          "href": "https://dashboard.photoito.kr"
        }
      ]
    },
    "groups": [
      {
        "group": "설치 및 수리",
        "pages": [
          "index",
          "as"
        ],
        "icon": "gear"
      },
      {
        "group": "키오스크",
        "pages": [
          "file",
          "file-2"
        ],
        "icon": "oven"
      },
      {
        "group": "대시보드",
        "pages": [
          "quickstart",
          "file-1",
          "file-3",
          "dashboard/index",
